# Local environment overrides (optional).
# Copy to .env (working directory) or to .env inside the agent home
# (~/.k41-agent by default) and adjust values. The agent loads these files at
# startup; variables already present in the process environment are never
# overwritten. Prefer dashboard Settings for runtime keys; these variables are
# useful for local dev fallbacks only.

# Agent home directory (defaults to ~/.k41-agent)
# K41_AGENT_HOME=

# web_search and web_fetch fallbacks when tools.web_search.* or tools.web_fetch.* are empty
# GOOGLE_API_KEY=
# GOOGLE_CSE_ID=
# TAVILY_API_KEY=
# FIRECRAWL_API_KEY=
# FIRECRAWL_BASE_URL=
# BING_API_KEY=
# BRAVE_API_KEY=

# LLM provider keys are normally configured in dashboard Settings > Providers.
# The variables below are only read by external CLIs / local-dev helpers.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Platform-managed App identity (operator-only, self-host).
# End users never set these in the dashboard; they only Install the GitHub App
# and configure per-repository triggers, or press Connect for Google Calendar.
# GitHub App (required for GitHub automation webhook):
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_PRIVATE_KEY_PATH=
# GITHUB_WEBHOOK_SECRET=
# Google OAuth App (required for Google Calendar Connect):
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:4141/integrations/google/callback
