{
  "name": "k41-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "check": "tsc --noEmit",
    "test": "node --test tests/chat-scroll.test.mjs tests/provider-connections.test.mjs tests/reasoning-effort.test.mjs tests/system-update.test.mjs && node scripts/verify-responsive.mjs --skip-build",
    "test:system-update": "node --test tests/system-update.test.mjs",
    "test:system-update-ui": "node scripts/verify-system-update.mjs",
    "test:chat-scroll": "node --test tests/chat-scroll.test.mjs",
    "test:providers-ui": "node scripts/verify-provider-connections.mjs",
    "test:effort-ui": "node scripts/verify-reasoning-effort.mjs",
    "test:mobile-ui": "node scripts/verify-mobile-layout.mjs"
  },
  "dependencies": {
    "@solidjs/router": "^0.15.3",
    "diff2html": "^3.4.56",
    "dompurify": "^3.4.5",
    "lucide-solid": "^0.562.0",
    "marked": "^18.0.4",
    "mermaid": "^11.15.0",
    "shiki": "^4.1.0",
    "solid-js": "^1.9.10"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-solid": "^2.11.12"
  }
