{
  "name": "k41-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:logs": "node --test tests/log-viewer.test.mjs",
    "test:logs-ui": "node scripts/verify-logs.mjs",
    "test:browser": "node --test tests/browser-viewer.test.mjs",
    "test:browser-ui": "node scripts/verify-browser.mjs",
    "test:browser-setup-ui": "node scripts/verify-browser-setup.mjs",
    "test:skills-ui": "node scripts/verify-skills.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/precompress-assets.mjs",
    "check": "tsc --noEmit",
    "test:compression": "node --test tests/precompress-assets.test.mjs",
    "test": "node --conditions=browser --test tests/solid-reactivity.test.mjs tests/nav-projects.test.mjs tests/no-workspace.test.mjs tests/workspace-refresh.test.mjs tests/chat-scroll.test.mjs tests/chat-model-preference.test.mjs tests/chat-export.test.mjs tests/visual-viewport.test.mjs tests/context-window.test.mjs tests/provider-connections.test.mjs tests/reasoning-effort.test.mjs tests/system-update.test.mjs tests/skill-suggestions.test.mjs tests/shell-tool-result.test.mjs tests/browser-viewer.test.mjs tests/protocol-stream.test.mjs tests/transcript-activity.test.mjs tests/thinking.test.mjs tests/markdown-blocks.test.mjs tests/acp.test.mjs tests/permission-mode.test.mjs tests/log-viewer.test.mjs && node scripts/verify-responsive.mjs --skip-build",
    "test:chat-export": "node --test tests/chat-export.test.mjs",
    "test:chat-export-ui": "node scripts/verify-chat-export.mjs",
    "test:solid-ui": "node scripts/verify-solid-reactivity.mjs && node scripts/verify-solid-controls.mjs",
    "test:solid-controls": "node scripts/verify-solid-controls.mjs",
    "test:workspace-ui": "node scripts/verify-workspace.mjs",
    "test:workspace-preview": "node --test tests/workspace-preview.test.mjs",
    "test:workspace-refresh": "node --conditions=browser --test tests/workspace-refresh.test.mjs",
    "test:workspace-chat": "node scripts/verify-workspace-chat.mjs",
    "test:workspace-polling": "node scripts/verify-workspace-chat.mjs --workspace-only",
    "test:runtime-switch": "node scripts/verify-workspace-chat.mjs --runtime-only",
    "test:chat-resume": "node scripts/verify-chat-resume.mjs",
    "test:chat-switching": "node scripts/verify-chat-switching.mjs",
    "test:markdown-ui": "node scripts/verify-markdown-updates.mjs && node scripts/verify-markdown-updates.mjs --real-diagrams",
    "test:system-update": "node --test tests/system-update.test.mjs",
    "test:system-update-ui": "node scripts/verify-system-update.mjs",
    "test:chat-scroll": "node --test tests/chat-scroll.test.mjs",
    "test:providers-ui": "node scripts/verify-provider-connections.mjs",
    "test:acp-ui": "node scripts/verify-acp-sign-in.mjs",
    "test:model-pools-ui": "node scripts/verify-model-pools.mjs",
    "test:effort-ui": "node scripts/verify-reasoning-effort.mjs",
    "test:mobile-ui": "node scripts/verify-mobile-layout.mjs",
    "test:navbar-ui": "node scripts/verify-navbar.mjs",
    "test:nav-projects": "node --conditions=browser --test tests/nav-projects.test.mjs",
    "test:projects-ui": "node scripts/verify-projects.mjs"
  },
  "dependencies": {
    "@novnc/novnc": "1.5.0",
    "@solidjs/router": "^0.15.3",
    "diff2html": "^3.4.56",
    "dompurify": "^3.4.5",
    "lucide-solid": "^0.562.0",
    "marked": "^18.0.4",
    "pele": "1.6.0",
    "shiki": "^4.1.0",
    "solid-js": "^1.9.10"
  },
  "devDependencies": {
    "@langchain/protocol": "0.0.21",
    "@tailwindcss/vite": "^4.1.18",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-solid": "^2.11.12"
  }
}
